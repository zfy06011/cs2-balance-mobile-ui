# 复制为 .env 后按需修改
# ===== 应用 =====
APP_NAME=CS2余额助手
ENVIRONMENT=development
API_PREFIX=/api/v1

# ===== 数据库（开发用 SQLite；生产切换 PostgreSQL）=====
DATABASE_URL=sqlite:///./data/cs2_balance.db

# ===== 采集 =====
COLLECT_INTERVAL_MINUTES=30
STEAM_CURRENCY=23
STEAM_APPID=730
STEAM_REQ_DELAY_SECONDS=3.0
STEAM_COOKIE=

# ===== C5GAME =====
C5_OPENAPI_BASE=https://openapi.c5game.com
C5_APP_KEY=
C5_API_BASE=https://www.c5game.com/api

# ===== 业务规则（必须配置化，勿写死在代码）=====
# 7 天限制：exact_hours 表示 获得时间 + LOCK_HOURS 精确解锁
LOCK_DAYS=7
LOCK_MODE=exact_hours
LOCK_HOURS=168

# ===== 日志 =====
LOG_LEVEL=INFO
